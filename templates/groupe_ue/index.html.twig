{% extends 'base.html.twig' %}

{% block title %}GroupeUe index{% endblock %}

{% block body %}
    <h1>GroupeUe index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Remarque</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for groupe_ue in groupe_ues %}
            <tr>
                <td>{{ groupe_ue.id }}</td>
                <td>{{ groupe_ue.remarque }}</td>
                <td>
                    <a href="{{ path('app_groupe_ue_show', {'id': groupe_ue.id}) }}">show</a>
                    <a href="{{ path('app_groupe_ue_edit', {'id': groupe_ue.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_groupe_ue_new') }}">Create new</a>
{% endblock %}
