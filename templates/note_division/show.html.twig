{% extends 'base.html.twig' %}

{% block title %}NoteDivision{% endblock %}

{% block body %}
    <h1>NoteDivision</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ note_division.id }}</td>
            </tr>
            <tr>
                <th>Note</th>
                <td>{{ note_division.note }}</td>
            </tr>
            <tr>
                <th>NeutraliseNoteMini</th>
                <td>{{ note_division.neutraliseNoteMini ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>PointsJury</th>
                <td>{{ note_division.pointsJury }}</td>
            </tr>
            <tr>
                <th>IsDispense</th>
                <td>{{ note_division.isDispense ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Remarque</th>
                <td>{{ note_division.remarque }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_note_division_index') }}">back to list</a>

    <a href="{{ path('app_note_division_edit', {'id': note_division.id}) }}">edit</a>

    {{ include('note_division/_delete_form.html.twig') }}
{% endblock %}
