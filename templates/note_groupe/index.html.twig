{% extends 'base.html.twig' %}

{% block title %}NoteGroupe index{% endblock %}

{% block body %}
    <h1>NoteGroupe index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Note</th>
                <th>NeutralisNoteMini</th>
                <th>PointsJury</th>
                <th>IsDispense</th>
                <th>Remarque</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for note_groupe in note_groupes %}
            <tr>
                <td>{{ note_groupe.id }}</td>
                <td>{{ note_groupe.note }}</td>
                <td>{{ note_groupe.neutralisNoteMini ? 'Yes' : 'No' }}</td>
                <td>{{ note_groupe.pointsJury }}</td>
                <td>{{ note_groupe.isDispense ? 'Yes' : 'No' }}</td>
                <td>{{ note_groupe.remarque }}</td>
                <td>
                    <a href="{{ path('app_note_groupe_show', {'id': note_groupe.id}) }}">show</a>
                    <a href="{{ path('app_note_groupe_edit', {'id': note_groupe.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_note_groupe_new') }}">Create new</a>
{% endblock %}
