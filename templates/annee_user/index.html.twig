{% extends 'base.html.twig' %}

{% block title %}AnneeUser index{% endblock %}

{% block body %}
    <h1>AnneeUser index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Droit</th>
                <th>Remarque</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for annee_user in annee_users %}
            <tr>
                <td>{{ annee_user.id }}</td>
                <td>{{ annee_user.droit }}</td>
                <td>{{ annee_user.remarque }}</td>
                <td>
                    <a href="{{ path('app_annee_user_show', {'id': annee_user.id}) }}">show</a>
                    <a href="{{ path('app_annee_user_edit', {'id': annee_user.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_annee_user_new') }}">Create new</a>
{% endblock %}
