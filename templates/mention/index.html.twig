{% extends 'base.html.twig' %}

{% block title %}Mention index{% endblock %}

{% block body %}
    <h1>Mention index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>NomCourt</th>
                <th>Rang</th>
                <th>Remarque</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for mention in mentions %}
            <tr>
                <td>{{ mention.id }}</td>
                <td>{{ mention.nom }}</td>
                <td>{{ mention.nomCourt }}</td>
                <td>{{ mention.rang }}</td>
                <td>{{ mention.remarque }}</td>
                <td>
                    <a href="{{ path('app_mention_show', {'id': mention.id}) }}">show</a>
                    <a href="{{ path('app_mention_edit', {'id': mention.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_mention_new') }}">Create new</a>
{% endblock %}
