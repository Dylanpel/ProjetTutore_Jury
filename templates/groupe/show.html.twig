{% extends 'base.html.twig' %}

{% block title %}Groupe{% endblock %}

{% block body %}
    <h1>Groupe</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ groupe.id }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ groupe.type }}</td>
            </tr>
            <tr>
                <th>Ects</th>
                <td>{{ groupe.ects }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ groupe.nom }}</td>
            </tr>
            <tr>
                <th>MoyenneMinimale</th>
                <td>{{ groupe.moyenneMinimale }}</td>
            </tr>
            <tr>
                <th>Remarque</th>
                <td>{{ groupe.remarque }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_groupe_index') }}">back to list</a>

    <a href="{{ path('app_groupe_edit', {'id': groupe.id}) }}">edit</a>

    {{ include('groupe/_delete_form.html.twig') }}
{% endblock %}
