{% extends 'base.html.twig' %}

{% block title %}Annee{% endblock %}

{% block body %}
    <h1>Annee</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ annee.id }}</td>
            </tr>
            <tr>
                <th>An</th>
                <td>{{ annee.an }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ annee.nom }}</td>
            </tr>
            <tr>
                <th>NomCourt</th>
                <td>{{ annee.nomCourt }}</td>
            </tr>
            <tr>
                <th>IsCompensable</th>
                <td>{{ annee.isCompensable ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>MoyenneValidation</th>
                <td>{{ annee.moyenneValidation }}</td>
            </tr>
            <tr>
                <th>Remarque</th>
                <td>{{ annee.remarque }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_annee_index') }}">back to list</a>

    <a href="{{ path('app_annee_edit', {'id': annee.id}) }}">edit</a>

    {{ include('annee/_delete_form.html.twig') }}
{% endblock %}
